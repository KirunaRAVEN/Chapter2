{
    // --- Indentation ---
    "editor.tabSize": 4,
    "editor.insertSpaces": true, // ensures spaces instead of tabs
    "C_Cpp.vcFormat.indent.braces": false,
    "C_Cpp.vcFormat.indent.caseLabels": true,
    "C_Cpp.vcFormat.indent.caseContents": true,

    // --- Braces: K&R Style ---
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.class": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.lambda": "sameLine",
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyType": false,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyFunction": false,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyBlock": false,

    // --- Braces always required for single statements ---
    "C_Cpp.vcFormat.wrap.preserveBlocks": "allOneLine", // expands single-line if/loops into multi-line with braces

    // --- Pointer style (asterisk sticks to variable name) ---
    "C_Cpp.vcFormat.space.pointerReferenceAlignment": "left", 

    // --- General formatting ---
    "C_Cpp.clang_format_style": "file", // in case you use .clang-format
    "C_Cpp.formatting": "vcFormat"
}
